{"n":2,"columns":["TipoVinculo","Modalidad","RangoEdad","valor"],"rows":[{"TipoVinculo":"Amistades","Modalidad":"Presencial","RangoEdad":"18 a 20","n":149,"valor":0.6600239693192718},{"TipoVinculo":"Amistades","Modalidad":"Presencial","RangoEdad":"21 a 23","n":142,"valor":0.76690643863179},{"TipoVinculo":"Amistades","Modalidad":"Presencial","RangoEdad":"24 o más","n":69,"valor":0.7245341614906831},{"TipoVinculo":"Amistades","Modalidad":"Virtual","RangoEdad":"18 a 20","n":149,"valor":1.2298753595397893},{"TipoVinculo":"Amistades","Modalidad":"Virtual","RangoEdad":"21 a 23","n":142,"valor":1.2718561368209254},{"TipoVinculo":"Amistades","Modalidad":"Virtual","RangoEdad":"24 o más","n":69,"valor":1.394202898550725},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Presencial","RangoEdad":"18 a 20","n":149,"valor":0.34659156279961667},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Presencial","RangoEdad":"21 a 23","n":142,"valor":0.3304074446680082},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Presencial","RangoEdad":"24 o más","n":69,"valor":0.37189440993788825},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Virtual","RangoEdad":"18 a 20","n":149,"valor":0.5431112176414197},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Virtual","RangoEdad":"21 a 23","n":142,"valor":0.6143561368209259},{"TipoVinculo":"Compañeros de estudio","Modalidad":"Virtual","RangoEdad":"24 o más","n":69,"valor":0.6679399585921322},{"TipoVinculo":"Familia","Modalidad":"Presencial","RangoEdad":"18 a 20","n":149,"valor":1.394467881112177},{"TipoVinculo":"Familia","Modalidad":"Presencial","RangoEdad":"21 a 23","n":142,"valor":1.448254527162976},{"TipoVinculo":"Familia","Modalidad":"Presencial","RangoEdad":"24 o más","n":69,"valor":1.3404140786749488},{"TipoVinculo":"Familia","Modalidad":"Virtual","RangoEdad":"18 a 20","n":149,"valor":1.7791802492809174},{"TipoVinculo":"Familia","Modalidad":"Virtual","RangoEdad":"21 a 23","n":142,"valor":1.9484255533199213},{"TipoVinculo":"Familia","Modalidad":"Virtual","RangoEdad":"24 o más","n":69,"valor":1.9666356107660452},{"TipoVinculo":"Pareja","Modalidad":"Presencial","RangoEdad":"18 a 20","n":149,"valor":0.6674017257909871},{"TipoVinculo":"Pareja","Modalidad":"Presencial","RangoEdad":"21 a 23","n":142,"valor":0.7596579476861168},{"TipoVinculo":"Pareja","Modalidad":"Presencial","RangoEdad":"24 o más","n":69,"valor":0.8334161490683223},{"TipoVinculo":"Pareja","Modalidad":"Virtual","RangoEdad":"18 a 20","n":149,"valor":0.8852205177372967},{"TipoVinculo":"Pareja","Modalidad":"Virtual","RangoEdad":"21 a 23","n":142,"valor":0.9107595573440651},{"TipoVinculo":"Pareja","Modalidad":"Virtual","RangoEdad":"24 o más","n":69,"valor":1.0601656314699794}],"sql":"-- R2: horas semanales significativas por vínculo y modalidad x rango de edad\nWITH h AS (\nSELECT h.KeyEstudiante, dt.InicioSemana, di.TipoVinculo, di.Modalidad, SUM(h.HorasSignificativas) AS x\nFROM Hecho_Interaccion h\nJOIN DimTiempo dt ON dt.KeyTiempo = h.KeyTiempo\nJOIN DimInteraccionSocial di ON di.KeyInteraccion = h.KeyInteraccion\nGROUP BY h.KeyEstudiante, dt.InicioSemana, di.TipoVinculo, di.Modalidad),\ntipos AS (SELECT DISTINCT TipoVinculo, Modalidad FROM DimInteraccionSocial)\nSELECT t.TipoVinculo, t.Modalidad, de.RangoEdad,\nn = COUNT(DISTINCT c.KeyEstudiante),\nvalor = AVG(CAST(ISNULL(h.x, 0) AS FLOAT))\nFROM v_calendario c\nJOIN DimEstudiante de ON de.KeyEstudiante = c.KeyEstudiante\nJOIN DimProgramaAcademico dp ON dp.KeyPrograma = c.KeyPrograma\nJOIN v_semana_ola so ON so.InicioSemana = c.InicioSemana\nCROSS JOIN tipos t\nLEFT JOIN h ON h.KeyEstudiante = c.KeyEstudiante AND h.InicioSemana = c.InicioSemana\nAND h.TipoVinculo = t.TipoVinculo AND h.Modalidad = t.Modalidad\nGROUP BY t.TipoVinculo, t.Modalidad, de.RangoEdad\nORDER BY t.TipoVinculo, t.Modalidad, de.RangoEdad","ms":646,"validated":true,"design":["TipoVinculo","Modalidad","RangoEdad","valor"],"k":5}