{
  "name": "bienestar-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "mssql": "^11.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
